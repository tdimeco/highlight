{
	"name": "highlight",
	"author": "Taegon Kim",
	"private": true,
	"scripts": {
		"postinstall": "del Highlight/scripts && npm run copy-css && node build.js",
		"copy-css": "make-dir Highlight/scripts/styles && cpy 'node_modules/highlight.js/styles/**/*.min.css' Highlight/scripts/styles"
	},
	"dependencies": {
		"cpy-cli": "^6.0.0",
		"del-cli": "^7.0.0",
		"glob": "^13.0.0",
		"highlight.js": "11.11.1",
		"make-dir-cli": "^4.0.0"
	}
}
